import os
import subprocess
from datetime import date
from concurrent.futures import ThreadPoolExecutor

import pandas as pd

# ---------------------------------------------------------------------------
# CONFIG
# ---------------------------------------------------------------------------

script_dir = "/home/scripts/sql_queries/ace/Volume"

# Map: txt file produced by the .sh script -> (master csv filename, header label for column A)
FILE_MAP = {
    "exp_service.txt": ("Servicewise_EXP.csv", "Service Name"),
    "sys_Service.txt": ("Servicewise_SYS.csv", "Service Name"),
    "exp_server.txt":  ("Serverwise_EXP.csv",  "SERVER"),
    "sys_server.txt":  ("Serverwise_SYS.csv",  "SERVER"),
    "exp_port.txt":    ("Portwise_EXP.csv",    "PORT"),
    "sys_port.txt":    ("Portwise_SYS.csv",    "PORT"),
}

TODAY_COL = date.today().strftime("%-d-%b")  # e.g. "28-Aug"


# ---------------------------------------------------------------------------
# STEP 1: run all .sh scripts in parallel
# ---------------------------------------------------------------------------

def get_scripts():
    return [f for f in os.listdir(script_dir) if f.endswith(".sh")]


def run_script(script):
    subprocess.run(["bash", os.path.join(script_dir, script)])


def run_all_scripts():
    scripts = get_scripts()
    try:
        with ThreadPoolExecutor() as executor:
            print("getting the thread pool")
            list(executor.map(run_script, scripts))  # wait for all to finish
    except Exception as e:
        print("was not able to query the result:", e)


# ---------------------------------------------------------------------------
# STEP 2: parse a "KEY:COUNT" txt file into a pandas Series (today's column)
# ---------------------------------------------------------------------------

def parse_txt(path):
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        print(f"[warn] missing or empty file: {path}")
        return None
    try:
        df = pd.read_csv(
            path,
            sep=":",
            header=None,
            names=["Key", TODAY_COL],
            engine="python",
        )
        df["Key"] = df["Key"].astype(str).str.strip()
        return df.set_index("Key")[TODAY_COL]
    except Exception as e:
        print(f"[error] failed to parse {path}: {e}")
        return None


# ---------------------------------------------------------------------------
# STEP 3: append today's column to each category's wide master CSV
# Handles:
#   - a service/server/port that had NO hits today -> gets 0, not blank
#   - a NEW service/server/port never seen before -> new row added,
#     with 0 filled in for all past dates it didn't exist for
# ---------------------------------------------------------------------------

def update_master_csv(txt_file, csv_file, index_label):
    txt_path = os.path.join(script_dir, txt_file)
    csv_path = os.path.join(script_dir, csv_file)

    new_series = parse_txt(txt_path)
    if new_series is None:
        return

    if os.path.exists(csv_path):
        existing = pd.read_csv(csv_path, index_col=0)
        existing.index.name = index_label
        existing = existing.drop(columns=[TODAY_COL], errors="ignore")  # re-run safe

        # outer join = keeps old rows not seen today AND adds new rows seen today
        merged = existing.join(new_series, how="outer")
    else:
        merged = new_series.to_frame()

    # any gap (old row missing today's hits, or new row missing past dates) -> 0
    merged = merged.fillna(0)

    # keep whole-number counts, not 0.0 / 123.0
    merged = merged.astype(int, errors="ignore")

    merged.index.name = index_label
    merged = merged.sort_index()
    merged.to_csv(csv_path)
    print(f"[ok] updated: {csv_path}")


def update_all():
    for txt_file, (csv_file, index_label) in FILE_MAP.items():
        update_master_csv(txt_file, csv_file, index_label)


# ---------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    run_all_scripts()
    update_all()

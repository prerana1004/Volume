import os
import subprocess
from datetime import date
from concurrent.futures import ThreadPoolExecutor

import pandas as pd

# ---------------------------------------------------------------------------
# CONFIG
# ---------------------------------------------------------------------------

script_dir = "/home/scripts/sql_queries/ace/Volume"
master_path = os.path.join(script_dir, "master_report.csv")  # <-- CSV, no openpyxl needed

# Each combined txt file (one per query, e.g. exp_combined.txt, sys_combined.txt)
# holding lines like: ServiceName:Port:Server:Count
COMBINED_FILES = [
    "exp_combined.txt",
    "sys_combined.txt",
]

TODAY_COL = date.today().strftime("%-d-%b")  # e.g. "28-Aug"
KEY_COLS = ["Service Name", "Port", "Server"]


# ---------------------------------------------------------------------------
# STEP 1: run all .sh scripts in parallel
# ---------------------------------------------------------------------------

def get_scripts():
    return [f for f in os.listdir(script_dir) if f.endswith(".sh")]


def run_script(script):
    subprocess.run(["bash", os.path.join(script_dir, script)])


def run_all_scripts():
    scripts = get_scripts()
    try:
        with ThreadPoolExecutor() as executor:
            print("getting the thread pool")
            list(executor.map(run_script, scripts))  # wait for all to finish
    except Exception as e:
        print("was not able to query the result:", e)


# ---------------------------------------------------------------------------
# STEP 2: parse "Service:Port:Server:Count" lines into a DataFrame
# ---------------------------------------------------------------------------

def parse_combined_file(path):
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        print(f"[warn] missing or empty file: {path}")
        return None
    try:
        df = pd.read_csv(
            path,
            sep=":",
            header=None,
            names=["Service Name", "Port", "Server", TODAY_COL],
            engine="python",
        )
        for col in KEY_COLS:
            df[col] = df[col].astype(str).str.strip()
        return df
    except Exception as e:
        print(f"[error] failed to parse {path}: {e}")
        return None


# ---------------------------------------------------------------------------
# STEP 3: merge into single master CSV, keyed on (Service, Port, Server)
# ---------------------------------------------------------------------------

def load_existing():
    if not os.path.exists(master_path):
        return None
    return pd.read_csv(master_path)


def update_master():
    all_new = []
    for fname in COMBINED_FILES:
        parsed = parse_combined_file(os.path.join(script_dir, fname))
        if parsed is not None:
            all_new.append(parsed)

    if not all_new:
        print("[warn] no new data parsed, skipping write")
        return

    new_data = pd.concat(all_new, ignore_index=True)
    # if the same combo appears in more than one file, sum today's counts
    new_data = new_data.groupby(KEY_COLS, as_index=False)[TODAY_COL].sum()

    existing = load_existing()
    if existing is not None:
        existing = existing.drop(columns=[TODAY_COL], errors="ignore")  # re-run safe
        merged = existing.merge(new_data, on=KEY_COLS, how="outer")
    else:
        merged = new_data

    merged = merged.sort_values(KEY_COLS).reset_index(drop=True)
    merged.to_csv(master_path, index=False)

    print(f"[ok] master file updated: {master_path}")


# ---------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    run_all_scripts()
    update_master()

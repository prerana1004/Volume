import os
import subprocess
import pandas as pd
from concurrent.futures import ThreadPoolExecutor

# Folder configuration
script_dir = "/home/scripts/sql_queries/ace/"

# Get all database extraction shell scripts to run
scripts = [f for f in os.listdir(script_dir) if f.endswith(".sh")]

def run_script(script):
    """Runs a single shell script cleanly."""
    script_path = os.path.join(script_dir, script)
    subprocess.run(["bash", script_path])

def build_data_dump_excel():
    """Combines all 6 text files into ONE clean dump sheet for easy Excel VLOOKUP."""
    print("Gathering data from all text extracts...")
    txt_files = [f for f in os.listdir(script_dir) if f.endswith(".txt")]
    
    if not txt_files:
        print("No data text files found!")
        return

    # This creates a small temporary file you can download to your laptop
    dump_excel_file = os.path.join(script_dir, "today_dump.xlsx")
    
    # We will combine all data into one single layout list
    combined_master_list = []
    
    for txt_file in txt_files:
        file_path = os.path.join(script_dir, txt_file)
        
        if os.path.getsize(file_path) == 0:
            continue
            
        try:
            # 1. Read raw comma data from the DB text file
            df = pd.read_csv(file_path, sep=",", names=["MATCH_KEY", "VOLUME"])
            
            # 2. AUTOMATICALLY CLEAN DATA (Strip spaces and remove blanks)
            df = df.dropna(subset=["MATCH_KEY"])
            df["MATCH_KEY"] = df["MATCH_KEY"].astype(str).str.strip()
            df = df[df["MATCH_KEY"] != ""]
            
            # Remove trailing decimals from numbers if any exist (e.g. '4013.0' -> '4013')
            df["MATCH_KEY"] = df["MATCH_KEY"].apply(lambda x: x[:-2] if x.endswith(".0") else x)
            
            combined_master_list.append(df)
            print(f"Successfully processed and cleaned text file: [{txt_file}]")
            
        except Exception as e:
            print(f"Could not process file {txt_file}: {e}")
            
    if combined_master_list:
        # Stack all 6 file contents on top of each other into one giant list
        final_df = pd.concat(combined_master_list, ignore_index=True)
        
        # Save it into a single clean sheet
        final_df.to_excel(dump_excel_file, sheet_name="Database_Data", index=False)
        print(f"✨ Success! Your clean copy-paste dump file is ready at: {dump_excel_file}")
    else:
        print("No valid database records were found to merge.")

if __name__ == "__main__":
    try:
        # Step A: Run all queries in parallel
        with ThreadPoolExecutor() as executor:
            print("Running database queries...")
            executor.map(run_script, scripts)
            
        # Step B: Clean and merge data into today_dump.xlsx
        build_data_dump_excel()
        
    except Exception as overall_error:
        print(f"Process crashed: {overall_error}")
